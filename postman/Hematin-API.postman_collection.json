    {
      "name": "02. Transactions (Core CRUD + Path & Query Params)",
      "item": [
        {
          "name": "1. CREATE - Tambah Pemasukan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('transactionId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"pemasukan\",\n  \"category\": \"Gaji\",\n  \"amount\": 1500000,\n  \"note\": \"Uang Saku Bulanan\",\n  \"date\": \"2026-11-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "2. CREATE - Tambah Pengeluaran",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('transactionId', json.data._id);",
                  "}"
