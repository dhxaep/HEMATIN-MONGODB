          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"pengeluaran\",\n  \"category\": \"Makanan\",\n  \"amount\": 25000,\n  \"note\": \"Nasi Padang Kantin UPNVJ\",\n  \"date\": \"2026-11-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
