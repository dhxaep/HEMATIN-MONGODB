# Port server ExpressJS
PORT=5000

# URL koneksi MongoDB Lokal (MongoDB Community Server pada port default 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/hematin

# Origin frontend yang diizinkan oleh CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# Wajib untuk fitur AI Financial Advisor: Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
